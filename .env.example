# Knownworld environment reference (both services + deploy scripts).
# Copy to .env for local dev; never commit .env (gitignored).

# ---- Shared / deploy scripts (infra/setup-gcp.sh, deploy.sh) -----------------
# GCP project to set up and deploy into (self-deploy: use YOUR project id).
PROJECT_ID=your-gcp-project-id
# Region for everything: Cloud Run, Firestore, Artifact Registry, Vertex AI.
REGION=us-central1

# ---- agents service (Cloud Run: knownworld-agents; local: port 8787) ---------
# Route google-genai through Vertex AI (uses the service account, no API key).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Project + location for Vertex AI calls (mirror PROJECT_ID / REGION).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Model for refine / enrich+verify / outreach drafting (hackathon minimum: 3.5 Flash).
GEMINI_MODEL=gemini-3.5-flash
# App-level auth: the agents URL is public (browser calls it directly), every
# request must present this token. Production: mounted from Secret Manager
# secret 'agents-api-token' (created by infra/setup-gcp.sh, printed ONCE).
# Retrieve: gcloud secrets versions access latest --secret=agents-api-token
AGENTS_API_TOKEN=
# Enrich fan-out. 'local' (dev default) runs per-person enrich jobs in-process;
# 'cloud' enqueues one Cloud Tasks task per person (deploy.sh sets this).
TASKS_MODE=local
# Cloud Tasks queue name (created by infra/setup-gcp.sh in REGION).
TASKS_QUEUE=knownworld-enrich
# Service account whose OIDC token authenticates queue pushes back into the
# agents service (needs run.invoker; setup-gcp.sh grants it).
TASKS_SA_EMAIL=knownworld-agents@your-gcp-project-id.iam.gserviceaccount.com
# The agents service's OWN public URL. Cloud Tasks pushes /enrich/task here.
# deploy.sh fills this in a second pass after the first deploy. Local: unset.
SERVICE_URL=
# Local dev only: 1 = stub Gemini responses so the loop runs offline (no GCP
# auth, no spend). Never set in production.
FAKE_LLM=
# Port the agents service listens on (Cloud Run injects its own; run-local.sh
# defaults to 8787 to match web/.env.development).
PORT=8787

# ---- web dashboard (Cloud Run: knownworld-web; local: port 3040) -------------
# Base URL of the agents service as the BROWSER sees it. v2 routes through
# the same-origin session proxy: pages call /agents/*, the proxy attaches the
# session cookie and forwards to AGENTS_UPSTREAM (see web/.env.development,
# which sets both for local dev: /agents -> http://localhost:8787).
NEXT_PUBLIC_AGENTS_URL=/agents
# LEGACY (v1): the shared basic-auth gate. v2 replaced it with per-account
# signup + httpOnly session JWTs (web/src/proxy.ts); these are kept only so
# deploy.sh keeps mounting the 'dashboard-auth' secret without changes.
BASIC_AUTH_USER=knownworld
BASIC_AUTH_PASS=
