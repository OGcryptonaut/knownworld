# Dev routing (no secrets): pages call same-origin /agents/* so the proxy can
# attach the session cookie; the proxy forwards to the local agents service.
NEXT_PUBLIC_AGENTS_URL=/agents
AGENTS_UPSTREAM=http://localhost:8787
# Dev-only sample loader for the wizard (gated to NODE_ENV=development)
DEV_EXPORT_PATH=../sample-data/result.json
NEXT_PUBLIC_GOOGLE_CLIENT_ID=148861534169-23uticgb5evvr8o1el3vpfelmsc1qf8n.apps.googleusercontent.com
