# Knownworld agents service: every env var, with defaults.

# Use Vertex AI (TRUE) or the Gemini API key path (FALSE). Default TRUE.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# GCP project + region for Vertex AI and Firestore.
GOOGLE_CLOUD_PROJECT=project-b6de64c7-201b-4885-92d
GOOGLE_CLOUD_LOCATION=global

# Resolved Gemini model id (hackathon mandate: 3.5 Flash or newer).
GEMINI_MODEL=gemini-3.5-flash

# 1 = deterministic canned model output, no GCP calls (tests / local dev).
FAKE_LLM=0

# 1 = in-memory store instead of Firestore. Defaults to the value of
# FAKE_LLM unless set explicitly.
FAKE_FIRESTORE=0

# App-level auth token required on every request (the Cloud Run URL is
# public). Production: mounted from Secret Manager secret 'agents-api-token'.
# Local dev: leave empty or set any value your local dashboard sends.
AGENTS_API_TOKEN=

# Enrich fan-out mode: 'local' (default for dev) runs per-person jobs
# in-process; 'cloud' enqueues to Cloud Tasks (deploy.sh sets this on Cloud Run).
TASKS_MODE=local
# Cloud Tasks queue for per-person enrich jobs (infra/setup-gcp.sh creates it).
TASKS_QUEUE=knownworld-enrich
# Service account for the OIDC token on each queue push (has run.invoker).
TASKS_SA_EMAIL=knownworld-agents@project-b6de64c7-201b-4885-92d.iam.gserviceaccount.com
# This service's own public URL. Cloud Tasks pushes POST /enrich/task here.
# deploy.sh sets it in a second pass after the first deploy. Local: unset.
SERVICE_URL=

# Browser origin allowed by CORS (localhost:3040 and :3000 always allowed).
FRONTEND_ORIGIN=http://localhost:3040

# Listen port (Cloud Run injects its own).
PORT=8080

# Optional cost-table override: "model-prefix=usd_per_1M_in:usd_per_1M_out",
# comma-separated. Unknown models cost 0 with a note in activity detail.
# COST_TABLE=gemini-3.5-flash=0.10:0.40

# ---- v2 -----------------------------------------------------------------
# Persistence triad: firestore | local | memory. 'local' = JSON files under
# LOCAL_STORE_DIR, zero GCP. Switch to 'firestore' when deploying.
STORE_MODE=local
LOCAL_STORE_DIR=./data-local-store

# Signs session JWTs. Cloud: set from Secret Manager. Local mode: leave
# unset: generated once and persisted under LOCAL_STORE_DIR.
AUTH_SECRET=

# Model backend: 'gemini' (the mandate, all deploys) or 'claude' (dev-only local
# testing: claude-haiku-4-5 via the Anthropic SDK; auth = `ant auth login`
# once, or ANTHROPIC_API_KEY). deploy.sh refuses MODEL_BACKEND=claude.
MODEL_BACKEND=gemini
CLAUDE_MODEL=claude-haiku-4-5
