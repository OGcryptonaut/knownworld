# Knownworld agents service — every env var, with defaults.

# Use Vertex AI (TRUE) or the Gemini API key path (FALSE). Default TRUE.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# GCP project + region for Vertex AI and Firestore.
GOOGLE_CLOUD_PROJECT=project-b6de64c7-201b-4885-92d
GOOGLE_CLOUD_LOCATION=us-central1

# Resolved Gemini model id (hackathon mandate: 3.5 Flash or newer).
GEMINI_MODEL=gemini-3.5-flash

# 1 = deterministic canned model output, no GCP calls (tests / local dev).
FAKE_LLM=0

# 1 = in-memory store instead of Firestore. Defaults to the value of
# FAKE_LLM unless set explicitly.
FAKE_FIRESTORE=0

# Browser origin allowed by CORS (localhost:3040 and :3000 always allowed).
FRONTEND_ORIGIN=http://localhost:3040

# Listen port (Cloud Run injects its own).
PORT=8080

# Optional cost-table override: "model-prefix=usd_per_1M_in:usd_per_1M_out",
# comma-separated. Unknown models cost 0 with a note in activity detail.
# COST_TABLE=gemini-3.5-flash=0.10:0.40
